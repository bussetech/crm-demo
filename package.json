{
  "name": "crm-demo",
  "private": true,
  "version": "0.1.0",
  "description": "CRM Demo \u2014 a deliberately generic multi-tenant CRM run as a live public demonstration of the studio's SaaS capability",
  "type": "module",
  "scripts": {
    "dev": "scripts/dev.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/isolation.test.ts' --exclude 'test/routes.test.ts' --exclude 'test/writes.test.ts' --exclude 'test/reset.test.ts'",
    "test:isolation": "scripts/run-isolation.sh",
    "seed": "scripts/stack-env.sh npx tsx scripts/seed.ts",
    "db:reset": "supabase db reset",
    "db:rebuild": "supabase db reset && npm run seed && npm run test:isolation",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
